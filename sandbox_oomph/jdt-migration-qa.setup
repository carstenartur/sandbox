<?xml version="1.0" encoding="UTF-8"?>
<setup:Project
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:git="http://www.eclipse.org/oomph/setup/git/1.0"
    xmlns:jdt="http://www.eclipse.org/oomph/setup/jdt/1.0"
    xmlns:predicates="http://www.eclipse.org/oomph/predicates/1.0"
    xmlns:projects="http://www.eclipse.org/oomph/setup/projects/1.0"
    xmlns:setup="http://www.eclipse.org/oomph/setup/1.0"
    xmlns:setup.targlets="http://www.eclipse.org/oomph/setup/targlets/1.0"
    xmlns:setup.workingsets="http://www.eclipse.org/oomph/setup/workingsets/1.0"
    xsi:schemaLocation="http://www.eclipse.org/oomph/setup/git/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/Git.ecore http://www.eclipse.org/oomph/setup/jdt/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/JDT.ecore http://www.eclipse.org/oomph/predicates/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/Predicates.ecore http://www.eclipse.org/oomph/setup/projects/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/Projects.ecore http://www.eclipse.org/oomph/setup/targlets/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/SetupTarglets.ecore http://www.eclipse.org/oomph/setup/workingsets/1.0 https://raw.githubusercontent.com/eclipse-oomph/oomph/master/setups/models/SetupWorkingSets.ecore"
    name="sandbox.jdt.migration.qa"
    label="Sandbox upstream JDT migration QA">
  <annotation
      source="http://www.eclipse.org/oomph/setup/ConfigurationReference">
    <reference
        href="jdt-migration-qa.configuration.setup#/"/>
  </annotation>

  <setupTask
      xsi:type="jdt:JRETask"
      version="JavaSE-21"
      location="${jre.location-21}"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.sandbox.ref"
      defaultValue="main"
      label="Sandbox branch or tag">
    <description>The Sandbox source revision whose cleanup product is built for this QA run.</description>
  </setupTask>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.eclipse.release"
      value="2026-06"
      storageURI="scope://Workspace"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.jdt.core.ref"
      value="R4_40"
      storageURI="scope://Workspace"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.jdt.core.commit"
      value="ef3d6f2115df89d7964bc13aa363ab8d6bd21256"
      storageURI="scope://Workspace"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.jdt.ui.ref"
      value="R4_40"
      storageURI="scope://Workspace"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.jdt.ui.commit"
      value="c922f757b27b7e2b6215db383cec5f8aafd13227"
      storageURI="scope://Workspace"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.jdt.core.binaries.ref"
      value="R4_40"
      storageURI="scope://Workspace"/>
  <setupTask
      xsi:type="setup:VariableTask"
      name="sandbox.qa.jdt.core.binaries.commit"
      value="0b8255ae33fc91724774ab2b550276191f9db416"
      storageURI="scope://Workspace"/>

  <setupTask
      xsi:type="git:GitCloneTask"
      id="github.clone.sandbox.qa"
      remoteURI="https://github.com/carstenartur/sandbox.git"
      checkoutBranch="${sandbox.qa.sandbox.ref}">
    <description>Sandbox sources used to build the cleanup product under test.</description>
  </setupTask>
  <setupTask
      xsi:type="git:GitCloneTask"
      id="github.clone.jdt.core.qa"
      remoteURI="https://github.com/eclipse-jdt/eclipse.jdt.core.git"
      checkoutBranch="${sandbox.qa.jdt.core.ref}">
    <description>JDT Core R4_40 source corpus.</description>
  </setupTask>
  <setupTask
      xsi:type="git:GitCloneTask"
      id="github.clone.jdt.ui.qa"
      remoteURI="https://github.com/eclipse-jdt/eclipse.jdt.ui.git"
      checkoutBranch="${sandbox.qa.jdt.ui.ref}">
    <description>JDT UI R4_40 source corpus for the subsequent JUnit 4 scenarios.</description>
  </setupTask>
  <setupTask
      xsi:type="git:GitCloneTask"
      id="github.clone.jdt.core.binaries.qa"
      remoteURI="https://github.com/eclipse-jdt/eclipse.jdt.core.binaries.git"
      checkoutBranch="${sandbox.qa.jdt.core.binaries.ref}">
    <description>JDT Core R4_40 test binaries required by the official test projects.</description>
  </setupTask>

  <setupTask
      xsi:type="setup.targlets:TargletTask"
      targetName="Sandbox upstream JDT migration QA target">
    <targlet
        name="Pinned JDT R4_40 QA corpus"
        activeRepositoryList="Eclipse 2026-06"
        includeSources="true">
      <requirement
          name="org.eclipse.platform.feature.group"/>
      <requirement
          name="org.eclipse.jdt.feature.group"/>
      <requirement
          name="org.eclipse.pde.feature.group"/>
      <requirement
          name="org.eclipse.equinox.executable.feature.group"/>
      <requirement
          name="org.eclipse.jdt.apt.tests"/>
      <requirement
          name="org.eclipse.jdt.core.tests.model"/>
      <requirement
          name="org.eclipse.jdt.core.tests.builder"/>
      <requirement
          name="org.eclipse.jdt.core.tests.compiler"/>
      <requirement
          name="org.eclipse.jdt.core.tests.binaries"/>
      <requirement
          name="org.eclipse.jdt.ui.tests"/>
      <sourceLocator
          rootFolder="${github.clone.jdt.core.qa.location}">
        <predicate
            xsi:type="predicates:NotPredicate">
          <operand
              xsi:type="predicates:NamePredicate"
              pattern="converterJclMin|converterJclMin1.5|org.eclipse.jdt.annotation_v1"/>
        </predicate>
      </sourceLocator>
      <sourceLocator
          rootFolder="${github.clone.jdt.core.binaries.qa.location}"/>
      <sourceLocator
          rootFolder="${github.clone.jdt.ui.qa.location}"/>
      <repositoryList
          name="Eclipse 2026-06">
        <repository
            url="https://download.eclipse.org/releases/2026-06/"/>
        <repository
            url="https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/2026-06/"/>
        <repository
            url="https://download.eclipse.org/cbi/updates/license"/>
      </repositoryList>
    </targlet>
  </setupTask>

  <setupTask
      xsi:type="projects:ProjectsImportTask">
    <sourceLocator
        rootFolder="${github.clone.sandbox.qa.location}"
        locateNestedProjects="true"/>
    <description>Import Sandbox source projects next to the pinned upstream corpus.</description>
  </setupTask>
  <setupTask
      xsi:type="setup.workingsets:WorkingSetTask">
    <workingSet
        name="Sandbox">
      <predicate
          xsi:type="predicates:NamePredicate"
          pattern="sandbox.*|org.sandbox.*"/>
    </workingSet>
    <workingSet
        name="JDT Core QA">
      <predicate
          xsi:type="predicates:NamePredicate"
          pattern="org.eclipse.jdt.*"/>
    </workingSet>
  </setupTask>
  <setupTask
      xsi:type="setup:ResourceCreationTask"
      targetURL="${workspace.location|uri}/.sandbox-jdt-migration-qa-pins.env"
      encoding="UTF-8">
    <content>
      PIN_ECLIPSE_RELEASE=2026-06
      PIN_JDT_CORE_REF=R4_40
      PIN_JDT_CORE_COMMIT=ef3d6f2115df89d7964bc13aa363ab8d6bd21256
      PIN_JDT_UI_REF=R4_40
      PIN_JDT_UI_COMMIT=c922f757b27b7e2b6215db383cec5f8aafd13227
      PIN_JDT_CORE_BINARIES_REF=R4_40
      PIN_JDT_CORE_BINARIES_COMMIT=0b8255ae33fc91724774ab2b550276191f9db416
    </content>
  </setupTask>
  <setupTask
      xsi:type="projects:ProjectsBuildTask">
    <description>Build the imported Sandbox and pinned JDT projects after target resolution.</description>
  </setupTask>

  <stream
      name="r4_40"
      label="Eclipse 4.40 / JDT R4_40"/>
  <description>
    Provisions the exact Eclipse 2026-06/JDT R4_40 source and test environment
    used by the Sandbox before-and-after migration documentation QA.
  </description>
</setup:Project>
