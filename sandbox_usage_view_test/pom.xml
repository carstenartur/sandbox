<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sandbox</groupId>
		<artifactId>central</artifactId>
		<version>1.3.3-SNAPSHOT</version>
	</parent>
	<artifactId>sandbox_usage_view_test</artifactId>
	<name>Sandbox usage view test</name>
	<packaging>eclipse-test-plugin</packaging>
	<dependencies>
		<dependency>
			<groupId>org.sandbox</groupId>
			<artifactId>sandbox_usage_view</artifactId>
		</dependency>
	</dependencies>
	<build>
		<testSourceDirectory>src</testSourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<useJDK>BREE</useJDK>
					<skip>false</skip>
					<useUIHarness>true</useUIHarness>
					<showEclipseLog>true</showEclipseLog>
					<argLine>-Dsandbox.repository.root="${maven.multiModuleProjectDirectory}"</argLine>
					<!-- Default: Exclude SWTBot tests -->
					<excludes>
						<exclude>**/*SWTBotTest.class</exclude>
					</excludes>
					<dependencies>
						<dependency>
							<type>eclipse-plugin</type>
							<groupId>org.sandbox</groupId>
							<artifactId>sandbox_usage_view</artifactId>
							<!-- This is the minimum required version -->
							<version>0.0.0</version>
						</dependency>
					</dependencies>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- SWTBot profile: Include all SWTBot tests. -->
		<profile>
			<id>swtbot</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.tycho</groupId>
						<artifactId>tycho-surefire-plugin</artifactId>
						<version>${tycho-version}</version>
						<configuration>
							<useUIThread>false</useUIThread>
							<excludes combine.self="override" />
							<includes>
								<include>**/*Test.class</include>
							</includes>
							<dependencies>
								<dependency>
									<type>eclipse-plugin</type>
									<artifactId>org.eclipse.swtbot.eclipse.finder</artifactId>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<artifactId>org.eclipse.swtbot.swt.finder</artifactId>
								</dependency>
							</dependencies>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			Generates the committed Eclipse Help screenshots from a real Eclipse
			workbench. The test writes directly into the corresponding *_help/images
			directories below the Maven checkout root. GitHub Actions only invokes
			the same local Maven profile; it is not part of the generation contract.
		-->
		<profile>
			<id>help-screenshots</id>
			<dependencies>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_css_cleanup</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_encoding_quickfix</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_functional_converter</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_int_to_enum</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_jface_cleanup</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_junit_cleanup</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_method_reuse</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_platform_helper</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_triggerpattern</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_use_general_type</artifactId>
					<version>${project.version}</version>
				</dependency>
				<dependency>
					<groupId>org.sandbox</groupId>
					<artifactId>sandbox_xml_cleanup</artifactId>
					<version>${project.version}</version>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.eclipse.tycho</groupId>
						<artifactId>tycho-surefire-plugin</artifactId>
						<version>${tycho-version}</version>
						<configuration>
							<useJDK>BREE</useJDK>
							<skip>false</skip>
							<useUIHarness>true</useUIHarness>
							<useUIThread>false</useUIThread>
							<showEclipseLog>true</showEclipseLog>
							<failIfNoTests>true</failIfNoTests>
							<forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
							<appArgLine>-nl en</appArgLine>
							<argLine>-Dsandbox.repository.root="${maven.multiModuleProjectDirectory}" -Dsandbox.help.screenshot.output="${maven.multiModuleProjectDirectory}" -Dsandbox.help.screenshot.mode=true -Duser.language=en -Duser.country=US -Duser.timezone=UTC -Dfile.encoding=UTF-8</argLine>
							<excludes combine.self="override" />
							<testClass>org.sandbox.jdt.ui.helper.views.SandboxHelpScreenshotsSWTBotTest</testClass>
							<dependencies>
								<dependency>
									<type>eclipse-plugin</type>
									<artifactId>org.eclipse.swtbot.eclipse.finder</artifactId>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<artifactId>org.eclipse.swtbot.swt.finder</artifactId>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_css_cleanup</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_encoding_quickfix</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_functional_converter</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_int_to_enum</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_jface_cleanup</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_junit_cleanup</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_method_reuse</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_platform_helper</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_triggerpattern</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_use_general_type</artifactId>
									<version>0.0.0</version>
								</dependency>
								<dependency>
									<type>eclipse-plugin</type>
									<groupId>org.sandbox</groupId>
									<artifactId>sandbox_xml_cleanup</artifactId>
									<version>0.0.0</version>
								</dependency>
							</dependencies>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
