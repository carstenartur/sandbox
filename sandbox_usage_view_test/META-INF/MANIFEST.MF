Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Usage view tests
Bundle-SymbolicName: sandbox_usage_view_test;singleton:=true
Bundle-Vendor: sandbox
Bundle-Version: 1.3.5.qualifier
Fragment-Host: sandbox_usage_view
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Eclipse-BundleShape: dir
Eclipse-BuddyPolicy: global
Import-Package: org.junit.jupiter.api;version="5.7.1",
 org.junit.jupiter.api.extension;version="5.7.1",
 org.junit.jupiter.api.io;version="5.7.1"
Require-Bundle: sandbox_test_commons,
 org.eclipse.jdt.core,
 org.eclipse.jdt.core.manipulation,
 org.eclipse.jdt.ui,
 org.eclipse.core.resources,
 org.eclipse.core.runtime,
 org.eclipse.core.commands,
 org.eclipse.jface.text,
 org.eclipse.text,
 org.eclipse.ui,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.swt,
 org.eclipse.jgit,
 org.eclipse.swtbot.swt.finder;resolution:=optional,
 org.eclipse.swtbot.eclipse.finder;resolution:=optional
Automatic-Module-Name: sandbox.usage.view.test
