Bundle-SymbolicName: sandbox_common_core
Bundle-Version: ${version_cleanup;${project.version}}
Bundle-Name: Sandbox Common Core
Bundle-Vendor: Carsten Hammer

Export-Package: org.sandbox.jdt.cleanup.multifile.api,\
 org.sandbox.jdt.container.api,\
 org.sandbox.jdt.container.analysis,\
 org.sandbox.jdt.internal.common,\
 org.sandbox.jdt.triggerpattern.api,\
 org.sandbox.jdt.triggerpattern.internal,\
 org.sandbox.jdt.triggerpattern.nullability,\
 org.sandbox.jdt.triggerpattern.llm,\
 org.sandbox.jdt.triggerpattern.git

# JDT intentionally splits core.compiler: IScanner/ITerminalSymbols live in
# org.eclipse.jdt.core, IProblem/InvalidInputException in compiler.batch.
# Require-Bundle uses JDT Core's reexport of compiler.batch to see both parts.
Require-Bundle: org.eclipse.jdt.core
Import-Package: !org.eclipse.jdt.core.compiler,*
