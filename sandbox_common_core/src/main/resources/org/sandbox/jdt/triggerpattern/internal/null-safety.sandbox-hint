"Consider Objects.equals only after checking stable operands and exact Object.equals dispatch.":
($x == null && $y == null) || ($x != null && $x.equals($y))
;;

"Consider !Objects.equals only after checking stable operands and exact Object.equals dispatch.":
($x == null && $y != null) || ($x != null && !$x.equals($y))
;;

@id: null.safety.remove-redundant-null-check.instanceof
@severity: info
"Remove redundant null check before instanceof for a stable literal or final local value.":
($x != null) && ($x instanceof $Type) :: isStableValue($x)
=> $x instanceof $Type
;;

@id: null.safety.remove-redundant-null-check.instanceof.reversed
@severity: info
"Remove redundant null check before instanceof (reversed operands) for a stable literal or final local value.":
(null != $x) && ($x instanceof $Type) :: isStableValue($x)
=> $x instanceof $Type
;;

@id: null.safety.remove-redundant-null-check.string-equals
@severity: info
"Remove redundant null check before String.equals for a string-literal receiver and stable literal or final local argument.":
($x != null) && ($constant.equals($x)) :: isStableValue($x) && isStringLiteral($constant)
=> $constant.equals($x)
;;

@id: null.safety.remove-redundant-null-check.string-equals.reversed
@severity: info
"Remove redundant null check before String.equals (reversed operands) for a string-literal receiver and stable literal or final local argument.":
(null != $x) && ($constant.equals($x)) :: isStableValue($x) && isStringLiteral($constant)
=> $constant.equals($x)
;;

@id: null.safety.remove-redundant-null-check.string-equalsignorecase
@severity: info
"Remove redundant null check before String.equalsIgnoreCase for a string-literal receiver and stable literal or final local argument.":
($x != null) && ($constant.equalsIgnoreCase($x)) :: isStableValue($x) && isStringLiteral($constant)
=> $constant.equalsIgnoreCase($x)
;;

@id: null.safety.remove-redundant-null-check.string-equalsignorecase.reversed
@severity: info
"Remove redundant null check before String.equalsIgnoreCase (reversed operands) for a string-literal receiver and stable literal or final local argument.":
(null != $x) && ($constant.equalsIgnoreCase($x)) :: isStableValue($x) && isStringLiteral($constant)
=> $constant.equalsIgnoreCase($x)
;;

@id: jdt.internal.semanticHighlightingReconciler.npe.fix
@severity: error
$document == $fSourceViewer.getDocument()
:: inClass("org.eclipse.jdt.internal.ui.javaeditor.SemanticHighlightingReconciler")
=> $fSourceViewer != null && $document == $fSourceViewer.getDocument()
;;

@id: jdt.internal.ui.javaoutlinepage.matches.npe.fix
@severity: error
$element.getElementType() == org.eclipse.jdt.core.IJavaElement.METHOD
:: inClass("org.eclipse.jdt.internal.ui.javaeditor.JavaOutlinePage")
=> $element != null && $element.getElementType() == org.eclipse.jdt.core.IJavaElement.METHOD
;;
