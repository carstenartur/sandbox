// misc.sandbox-hint — Miscellaneous improvement patterns
// Various code modernization and cleanup patterns

<!id: misc>
<!description: Miscellaneous code improvement patterns>
<!severity: info>
<!minJavaVersion: 8>
<!tags: misc, modernization>


@id: logical.simplification.not-equal-zero
@severity: info
"Simplify !($expr.length() == 0) to $expr.length() != 0 for improved readability.":
!($x.length() == 0) :: miscNoCommentsOrSwitch()
=> ($x.length() != 0)
;;

@id: logical.simplification.demorgan.or-negation
@severity: info
"Apply De Morgan's law: !(A || B) to !A && !B.":
!($a || $b) :: miscNoCommentsOrSwitch()
=> (!$a && !$b)
;;

@id: logical.simplification.demorgan.and-negation
@severity: info
"Apply De Morgan's law: !(A && B) to !A || !B.":
!($a && $b) :: miscNoCommentsOrSwitch()
=> (!$a || !$b)
;;

@id: logical.simplification.boolean-conditional
@severity: info
"Simplify condition ? true : false to condition.":
$condition ? true : false :: miscPrimitiveBooleanConditionalSafe()
=> $condition
;;
