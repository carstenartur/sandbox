<!id: collections-immutable>
<!description: Review collection factory candidates and their observable behavior>
<!severity: info>
<!minJavaVersion: 9>
<!tags: modernization, collections>

// List.of may reject nulls and does not preserve backing-array updates.
"Review immutable list factory candidate and its uses":
java.util.Collections.unmodifiableList(java.util.Arrays.asList($args)) :: sourceVersionGE(9)
;;

"Review singleton list factory candidate and its uses":
java.util.Collections.singletonList($x) :: sourceVersionGE(9)
;;

"Review singleton set factory candidate and its uses":
java.util.Collections.singleton($x) :: sourceVersionGE(9)
;;

"Review empty list factory candidate and its uses":
java.util.Collections.emptyList() :: sourceVersionGE(9)
;;

"Review empty set factory candidate and its uses":
java.util.Collections.emptySet() :: sourceVersionGE(9)
;;

"Review empty map factory candidate and its uses":
java.util.Collections.emptyMap() :: sourceVersionGE(9)
;;

"Review singleton map factory candidate and its uses":
java.util.Collections.singletonMap($k, $v) :: sourceVersionGE(9)
;;

"Review unmodifiable singleton map factory candidate and its uses":
java.util.Collections.unmodifiableMap(java.util.Collections.singletonMap($k, $v)) :: sourceVersionGE(9)
;;
