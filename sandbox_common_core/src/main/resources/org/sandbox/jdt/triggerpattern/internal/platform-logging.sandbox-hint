<!id: platform-logging>
<!description: Modernize Eclipse Platform logging API usage (Eclipse-specific)>
<!severity: info>
<!minJavaVersion: 11>
<!tags: eclipse, modernization, logging, eclipse-specific>

// Platform.getLog(bundle) → ILog.of(bundle)
org.eclipse.core.runtime.Platform.getLog($bundle)
=> org.eclipse.core.runtime.ILog.of($bundle)
;;

// Status constructor-to-factory rules intentionally do not belong here.
// Status.error(), Status.warning(), and Status.info() infer the plug-in id from
// the calling bundle and are not generally equivalent to constructors carrying
// an explicit identity. Safe Status simplification is provided by the dedicated
// Platform Status cleanup and its identity-preserving hint rules.
