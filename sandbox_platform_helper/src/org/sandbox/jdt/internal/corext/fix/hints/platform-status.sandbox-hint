// platform-status.sandbox-hint — semantics-preserving Status simplification
//
// The factory methods Status.error(), Status.warning(), and Status.info()
// infer the plug-in id from the calling bundle. They are not equivalent to an
// arbitrary explicit String or Class identity. These rules therefore remove
// only the redundant IStatus.OK argument and retain every other constructor
// argument.

<!id: platform-status>
<!description: Remove redundant IStatus.OK codes while preserving Status identity>
<!severity: warning>
<!minJavaVersion: 9>
<!tags: eclipse, modernization, platform, status, semantics-preserving>

// Five-argument Status constructors with an explicit IStatus.OK code can use
// the corresponding four-argument constructor. More general constant-value
// recognition (for example a literal or named compile-time zero) remains in the
// native cleanup, where JDT bindings and constant evaluation are available.

new org.eclipse.core.runtime.Status(org.eclipse.core.runtime.IStatus.ERROR, $pluginId, org.eclipse.core.runtime.IStatus.OK, $msg, $ex)
=> new org.eclipse.core.runtime.Status(org.eclipse.core.runtime.IStatus.ERROR, $pluginId, $msg, $ex)
;;

new org.eclipse.core.runtime.Status(org.eclipse.core.runtime.IStatus.WARNING, $pluginId, org.eclipse.core.runtime.IStatus.OK, $msg, $ex)
=> new org.eclipse.core.runtime.Status(org.eclipse.core.runtime.IStatus.WARNING, $pluginId, $msg, $ex)
;;

new org.eclipse.core.runtime.Status(org.eclipse.core.runtime.IStatus.INFO, $pluginId, org.eclipse.core.runtime.IStatus.OK, $msg, $ex)
=> new org.eclipse.core.runtime.Status(org.eclipse.core.runtime.IStatus.INFO, $pluginId, $msg, $ex)
;;

// Three- and four-argument constructors are already in the shortest available
// identity-preserving form and are intentionally not rewritten to factories.
