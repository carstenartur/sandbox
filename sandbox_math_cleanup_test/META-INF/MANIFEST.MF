Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Sandbox Mathematics Cleanup Test
Bundle-SymbolicName: sandbox_math_cleanup_test;singleton:=true
Bundle-Version: 1.3.6
Fragment-Host: sandbox_math_cleanup
Bundle-RequiredExecutionEnvironment: JavaSE-25
Require-Bundle: org.junit,
 org.eclipse.jdt.launching,
 org.eclipse.ltk.ui.refactoring,
 org.eclipse.swtbot.eclipse.finder;resolution:=optional,
 org.eclipse.swtbot.swt.finder;resolution:=optional
Bundle-ActivationPolicy: lazy
Eclipse-BundleShape: dir
Eclipse-BuddyPolicy: global
Import-Package: org.junit.jupiter.api,
 org.junit.jupiter.api.extension,
 org.junit.jupiter.api.io
Automatic-Module-Name: sandbox.math.cleanup.test
