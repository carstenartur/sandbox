Bundle-Name: Sandbox JUnit migration support
Bundle-SymbolicName: org.sandbox.junit.migration.support
Bundle-Version: ${qualifiedVersion}
Export-Package: org.sandbox.junit.jupiter
Import-Package: org.junit.platform.*;version="[1.14,7)",\
                org.junit.jupiter.*;version="[5.14,7)",\
                org.opentest4j;version="[1.3,2)",*
-reproducible: true
