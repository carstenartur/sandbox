<?xml version="1.0" encoding="UTF-8"?>
<plugin>
   <!--
      The iterator cleanup was upstreamed to Eclipse JDT UI. Keep the
      historical implementation in this bundle, but do not contribute the
      same org.eclipse.jdt.ui.cleanup.toolscleanup id a second time.
   -->
   <extension point="org.eclipse.ui.cheatsheets.cheatSheetContent">
      <cheatsheet
            id="org.sandbox.jdt.tools.gettingStarted"
            name="Converting Iterator Loops to Enhanced For Loops"
            contentFile="cheatsheets/iterator-to-for-getting-started.xml">
         <description>Use the maintained Eclipse JDT cleanup; Sandbox keeps this guided example as a reference.</description>
      </cheatsheet>
   </extension>
</plugin>
