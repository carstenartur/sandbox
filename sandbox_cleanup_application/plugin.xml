<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
<!-- =================================================================================== -->
<!-- Extension: Java Cleanup                                                            -->
<!-- =================================================================================== -->
<extension
      id="org.sandbox.jdt.core.JavaCleanup"
      point="org.eclipse.core.runtime.applications">
        <application>
          <run class="org.sandbox.jdt.core.cleanupapp.ScopeFilteringCodeCleanupApplicationWrapper" />
        </application>
</extension>

<extension
      id="org.sandbox.jdt.core.ProjectWideJavaCleanup"
      point="org.eclipse.core.runtime.applications">
        <application>
          <run class="org.sandbox.jdt.core.cleanupapp.HeadlessProjectWideCodeCleanupApplication" />
        </application>
</extension>

<!-- Optional: only instantiated by a JDT LS host. No automatic save action. -->
<extension point="org.eclipse.jdt.ls.core.delegateCommandHandler">
    <delegateCommandHandler class="org.sandbox.jdt.core.cleanupapp.jdtls.SandboxCleanUpCommands">
        <command id="sandbox.cleanup.list"/>
        <command id="sandbox.cleanup.preview"/>
    </delegateCommandHandler>
</extension>
</plugin>
