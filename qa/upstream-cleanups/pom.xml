<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.sandbox.qa</groupId>
  <artifactId>upstream-cleanups</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Pinned upstream cleanup corpus qualification</name>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <repo>${project.basedir}/../..</repo>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jgit</groupId><artifactId>org.eclipse.jgit</artifactId><version>7.8.0.202609011348-r</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <testSourceDirectory>${repo}</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version>
        <configuration>
          <testIncludes>
            <testInclude>qa/upstream-cleanups/src/test/java/**/*.java</testInclude>
            <testInclude>sandbox_common_test/src/org/sandbox/jdt/triggerpattern/test/policy/PinnedGitRepository.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version>
        <configuration>
          <workingDirectory>${repo}</workingDirectory>
          <systemPropertyVariables><sandbox.cleanup.repo>${repo}</sandbox.cleanup.repo></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
