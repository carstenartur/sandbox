<?xml version="1.0" encoding="UTF-8"?>
<plugin>
   <extension point="sandbox_common.planInspectors">
      <inspector contract="junit3-hierarchy" class="org.sandbox.jdt.internal.corext.fix.multifile.JUnitProjectPlanInspector"/>
      <inspector contract="junit4-parameterized" class="org.sandbox.jdt.internal.corext.fix.multifile.JUnitProjectPlanInspector"/>
   </extension>
	<extension point="org.eclipse.jdt.ui.cleanUps">
		<cleanUpConfigurationUI class="org.sandbox.jdt.internal.ui.preferences.cleanup.HelpAwareSandboxCodeTabPage" cleanUpKind="cleanUp" name="JUnit Migration (Sandbox)" />
		<cleanUpOptionsInitializer class="org.sandbox.jdt.internal.ui.preferences.cleanup.DefaultCleanUpOptionsInitializer" cleanUpKind="cleanUp"></cleanUpOptionsInitializer>
		
		<cleanUp class="org.sandbox.jdt.internal.ui.fix.JUnitCleanUp" id="org.eclipse.jdt.ui.cleanup.junitcleanup" />
		<!--      runAfter="org.eclipse.jdt.ui.cleanup.unboxing" -->
	</extension>
	<extension point="org.eclipse.core.runtime.adapters">
		<factory adaptableType="org.eclipse.jdt.internal.corext.fix.CoordinatedCleanUpChange"
			class="org.sandbox.jdt.internal.ui.fix.JUnitManifestChangeAdapter">
			<adapter type="org.eclipse.ltk.core.refactoring.Change"/>
		</factory>
	</extension>
	<extension point="org.sandbox.jdt.triggerpattern.hints">
		<hintFile
			id="junit5"
			resource="org/sandbox/jdt/internal/corext/fix/hints/junit5.sandbox-hint" />
		<hintFile
			id="assume5"
			resource="org/sandbox/jdt/internal/corext/fix/hints/assume5.sandbox-hint" />
		<hintFile
			id="annotations5"
			resource="org/sandbox/jdt/internal/corext/fix/hints/annotations5.sandbox-hint" />
	</extension>
   <extension point="org.eclipse.ui.cheatsheets.cheatSheetContent">
      <cheatsheet
            id="org.sandbox.jdt.junit.cleanup.gettingStarted"
            name="Migrating JUnit 3/4 Tests to JUnit 5"
            contentFile="cheatsheets/junit-migration-getting-started.xml">
         <description>Learn how to automatically migrate JUnit 3 and JUnit 4 test classes to JUnit 5</description>
      </cheatsheet>
   </extension>

</plugin>
