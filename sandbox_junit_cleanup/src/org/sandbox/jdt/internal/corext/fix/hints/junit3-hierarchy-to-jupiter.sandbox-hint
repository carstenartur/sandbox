=> org.junit.jupiter.api.Assertions.assertNotNull($value, $message)
;;

@id: junit3.planned.assertSame.message
assertSame($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertSame($expected, $actual, $message)
;;

@id: junit3.planned.assertSame.message.qualified
$owner.assertSame($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertSame($expected, $actual, $message)
;;

@id: junit3.planned.assertNotSame.message
assertNotSame($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertNotSame($expected, $actual, $message)
;;

@id: junit3.planned.assertNotSame.message.qualified
$owner.assertNotSame($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertNotSame($expected, $actual, $message)
;;

@id: junit3.planned.assertEquals.message
assertEquals($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertEquals($expected, $actual, $message)
;;

@id: junit3.planned.assertEquals.message.qualified
$owner.assertEquals($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertEquals($expected, $actual, $message)
;;

@id: junit3.planned.assertEquals.delta.message
assertEquals($message, $expected, $actual, $delta) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertEquals($expected, $actual, $delta, $message)
;;

@id: junit3.planned.assertEquals.delta.message.qualified
$owner.assertEquals($message, $expected, $actual, $delta) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertEquals($expected, $actual, $delta, $message)
;;

@id: junit3.planned.assertArrayEquals.message
assertArrayEquals($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertArrayEquals($expected, $actual, $message)
;;

@id: junit3.planned.assertArrayEquals.message.qualified
$owner.assertArrayEquals($message, $expected, $actual) :: plannedRole("JUNIT3_ASSERTION_MESSAGE_FIRST")
=> org.junit.jupiter.api.Assertions.assertArrayEquals($expected, $actual, $message)
;;

// All remaining supported overloads keep their argument order and only change owner.
@id: junit3.planned.assertEquals
assertEquals($args$) :: plannedRole("JUNIT3_ASSERTION_QUALIFY")
=> org.junit.jupiter.api.Assertions.assertEquals($args$)
;;

@id: junit3.planned.assertEquals.qualified
$owner.assertEquals($args$) :: plannedRole("JUNIT3_ASSERTION_QUALIFY")
=> org.junit.jupiter.api.Assertions.assertEquals($args$)
;;

@id: junit3.planned.assertArrayEquals
assertArrayEquals($args$) :: plannedRole("JUNIT3_ASSERTION_QUALIFY")
=> org.junit.jupiter.api.Assertions.assertArrayEquals($args$)
;;

@id: junit3.planned.assertArrayEquals.qualified
$owner.assertArrayEquals($args$) :: plannedRole("JUNIT3_ASSERTION_QUALIFY")
=> org.junit.jupiter.api.Assertions.assertArrayEquals($args$)
;;

