Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Sandbox Container Cleanup
Bundle-SymbolicName: sandbox_container_cleanup;singleton:=true
Bundle-Version: 1.3.4.qualifier
Bundle-Vendor: Carsten Hammer
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Require-Bundle: sandbox_common,
 sandbox_common_core,
 org.eclipse.core.runtime,
 org.eclipse.jdt.core,
 org.eclipse.jdt.ui,
 org.eclipse.jdt.core.manipulation,
 org.eclipse.ltk.core.refactoring,
 org.eclipse.text,
 org.eclipse.swt,
 org.eclipse.jface,
 org.eclipse.ui.workbench
Eclipse-RegisterBuddy: org.eclipse.jdt.core.manipulation
Eclipse-BuddyPolicy: global
Automatic-Module-Name: sandbox.container.cleanup
