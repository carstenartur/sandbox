<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion><parent><groupId>org.sandbox</groupId><artifactId>central</artifactId><version>1.3.10</version></parent>
 <artifactId>sandbox_math_cleanup</artifactId><name>Sandbox Mathematics Cleanup</name><packaging>eclipse-plugin</packaging>
 <dependencies><dependency><groupId>io.github.carstenartur</groupId><artifactId>sandbox-functional-converter-core</artifactId></dependency>
 <dependency><groupId>org.sandbox</groupId><artifactId>sandbox_functional_converter</artifactId><version>${project.version}</version><optional>true</optional></dependency>
 <dependency>
  <groupId>io.github.carstenartur</groupId>
  <artifactId>regelsuche-optimization-sdk</artifactId>
  <version>0.5.3</version>
  <optional>true</optional>
 </dependency></dependencies>
 <build><sourceDirectory>${project.basedir}/src</sourceDirectory>
  <plugins>
   <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-dependency-plugin</artifactId>
    <version>3.11.0</version>
    <executions>
     <execution>
      <id>embed-regelsuche-runtime</id>
      <?m2e execute onConfiguration?>
      <phase>generate-resources</phase>
      <goals><goal>copy-dependencies</goal></goals>
      <configuration>
       <graphRoots>
        <graphRoot>
         <groupId>io.github.carstenartur</groupId>
         <artifactId>regelsuche-optimization-sdk</artifactId>
        </graphRoot>
       </graphRoots>
       <includeScope>runtime</includeScope>
       <outputDirectory>${project.basedir}/lib</outputDirectory>
       <stripVersion>true</stripVersion>
       <overWriteReleases>true</overWriteReleases>
      </configuration>
     </execution>
    </executions>
   </plugin>
  </plugins>
 </build>
</project>
