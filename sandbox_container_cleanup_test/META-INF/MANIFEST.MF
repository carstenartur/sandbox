Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Sandbox Container Cleanup Test
Bundle-SymbolicName: sandbox_container_cleanup_test;singleton:=true
Bundle-Version: 1.3.5.qualifier
Fragment-Host: sandbox_container_cleanup
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.junit,
 sandbox_test_commons
Bundle-ActivationPolicy: lazy
Eclipse-BundleShape: dir
Eclipse-BuddyPolicy: global
Import-Package: org.junit.jupiter.api,
 org.junit.jupiter.api.extension,
 org.sandbox.jdt.ui.tests.quickfix.rules
Automatic-Module-Name: sandbox.container.cleanup.test
