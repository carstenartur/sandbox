Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Cleanup application tests
Bundle-SymbolicName: sandbox_cleanup_application_test;singleton:=true
Bundle-Vendor: sandbox
Bundle-Version: 1.3.11.qualifier
Fragment-Host: sandbox_cleanup_application
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-ActivationPolicy: lazy
Eclipse-BundleShape: dir
Eclipse-BuddyPolicy: global
Require-Bundle: org.eclipse.jdt.ls.core,
 org.eclipse.pde.core,
 sandbox_encoding_quickfix,
 sandbox_functional_converter,
 sandbox_platform_helper,
 sandbox_jface_cleanup,
 sandbox_junit_cleanup,
 sandbox_method_reuse,
 sandbox_int_to_enum,
 sandbox_math_cleanup,
 sandbox_container_cleanup,
 sandbox_use_general_type,
 sandbox_triggerpattern,
 sandbox_xml_cleanup,
 sandbox_tools
Import-Package: org.sandbox.junit.jupiter,
 org.junit.jupiter.api;version="[6,7)",
 org.junit.jupiter.api.extension;version="[6,7)",
 org.junit.jupiter.api.function;version="[6,7)",
 org.junit.jupiter.api.io;version="[6,7)",
 org.junit.jupiter.engine;version="[6,7)",
 org.junit.jupiter.params;version="[6,7)",
 org.junit.jupiter.params.provider;version="[6,7)",
 org.junit.platform.engine;version="[6,7)",
 org.junit.platform.engine.discovery;version="[6,7)",
 org.junit.platform.engine.support.descriptor;version="[6,7)",
 org.junit.platform.launcher;version="[6,7)",
 org.junit.platform.launcher.core;version="[6,7)",
 org.junit.platform.launcher.listeners;version="[6,7)",
 org.junit.platform.suite.engine;status=INTERNAL;version="[6,7)",
 org.sandbox.jdt.ui.tests.quickfix.rules
Automatic-Module-Name: sandbox.cleanup.application.test
