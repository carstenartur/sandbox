<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sandbox</groupId>
		<artifactId>central</artifactId>
		<version>1.3.5-SNAPSHOT</version>
	</parent>
	<artifactId>sandbox_css_cleanup_test</artifactId>
	<name>Sandbox CSS cleanup test</name>
	<packaging>eclipse-test-plugin</packaging>
	<properties>
		<frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
		<css-test-node.version>v24.20.0</css-test-node.version>
		<css-test-npm.version>11.19.0</css-test-npm.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.sandbox</groupId>
			<artifactId>sandbox_css_cleanup</artifactId>
		</dependency>
	</dependencies>
	<build>
		<testSourceDirectory>src</testSourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<id>prepare-css-test-tooling</id>
						<phase>initialize</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/css-tooling</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}/src/test/node</directory>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>${frontend-maven-plugin.version}</version>
				<configuration>
					<workingDirectory>${project.build.directory}/css-tooling</workingDirectory>
					<installDirectory>${project.build.directory}</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-css-test-node-and-npm</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>${css-test-node.version}</nodeVersion>
							<npmVersion>${css-test-npm.version}</npmVersion>
						</configuration>
					</execution>
					<execution>
						<id>install-css-test-packages</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci --ignore-scripts --no-audit --no-fund</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<showEclipseLog>true</showEclipseLog>
					<useJDK>BREE</useJDK>
					<useUIHarness>false</useUIHarness>
					<systemProperties>
						<sandbox.css.node.home>${project.build.directory}/node</sandbox.css.node.home>
						<sandbox.css.node.modules>${project.build.directory}/css-tooling/node_modules</sandbox.css.node.modules>
					</systemProperties>
					<dependencies>
						<dependency>
							<type>eclipse-plugin</type>
							<groupId>org.sandbox</groupId>
							<artifactId>sandbox_css_cleanup</artifactId>
							<!-- This is the minimum required version -->
							<version>0.0.0</version>
						</dependency>
					</dependencies>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
